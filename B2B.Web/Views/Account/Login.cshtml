@model B2B.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập Cổng Đại Lý";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5 col-lg-4">
        <div class="card card-custom p-4 shadow-sm">
            <div class="text-center mb-4">
                <div class="bg-primary bg-opacity-10 text-primary d-inline-block p-3 rounded-circle mb-2">
                    <i class="bi bi-shield-lock-fill fs-2"></i>
                </div>
                <h3 class="fw-bold text-primary mb-1">Cổng Đăng Nhập Đại Lý</h3>
                <p class="text-muted small">B2B Wholesale Ordering Portal (Chỉ dành cho Đại lý)</p>
            </div>

            <form asp-controller="Account" asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="UserName" class="form-label fw-semibold">Tên đăng nhập</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input asp-for="UserName" class="form-control" placeholder="Nhập username đại lý" autofocus />
                    </div>
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold">Mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-key"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label small">Ghi nhớ đăng nhập</label>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập Hệ Thống
                </button>
            </form>

            <div class="mt-4 pt-3 border-top">
                <h6 class="fw-bold text-secondary small mb-2"><i class="bi bi-info-circle me-1"></i> Tài khoản mẫu kiểm thử (Seed Data):</h6>
                <div class="bg-light p-2 rounded small" style="font-size: 0.82rem;">
                    <div><strong>Đại lý hợp lệ (Đăng nhập thành công):</strong></div>
                    <div class="text-primary">• Username: <code>agent_hanoi</code> / Pass: <code>agent123</code></div>
                    <div class="text-primary">• Username: <code>agent_saigon</code> / Pass: <code>agent123</code></div>
                    <hr class="my-1">
                    <div><strong>Thử nghiệm kiểm tra phân quyền (Chặn Admin):</strong></div>
                    <div class="text-danger">• Username: <code>admin</code> / Pass: <code>admin123</code> (Bị từ chối trên Web)</div>
                    <hr class="my-1">
                    <div><strong>Thử nghiệm tài khoản bị khóa:</strong></div>
                    <div class="text-muted">• Username: <code>agent_locked</code> / Pass: <code>agent123</code></div>
                </div>
            </div>
        </div>
    </div>
</div>
