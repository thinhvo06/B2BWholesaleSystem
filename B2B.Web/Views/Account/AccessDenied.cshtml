@{
    ViewData["Title"] = "Từ Chối Truy Cập";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card card-custom p-5">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-x fs-1"></i>
            </div>
            <h2 class="fw-bold text-danger">Từ Chối Truy Cập (403)</h2>
            <p class="text-muted mt-2">
                Bạn không có quyền truy cập vào chức năng hoặc khu vực này. Cổng Web Portal chỉ dành cho người dùng có vai trò <strong>Đại lý (Agent)</strong>.
            </p>
            <div class="mt-4">
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary px-4 me-2">
                    <i class="bi bi-house me-1"></i> Về Danh Mục Sản Phẩm
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-person-circle me-1"></i> Đổi Tài Khoản
                </a>
            </div>
        </div>
    </div>
</div>
