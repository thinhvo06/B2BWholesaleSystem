@model B2B.Web.Models.CartViewModel
@{
    ViewData["Title"] = "Giỏ Hàng Đặt Hàng Bán Buôn";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-primary mb-0">
        <i class="bi bi-cart3 me-2"></i>Giỏ Hàng Đặt Hàng Đại Lý
    </h3>
    <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Tiếp tục chọn mặt hàng
    </a>
</div>

@if (Model.IsEmpty)
{
    <div class="card card-custom p-5 text-center">
        <div class="text-muted fs-1 mb-3"><i class="bi bi-cart-x"></i></div>
        <h4 class="text-secondary fw-bold">Giỏ hàng của bạn đang trống</h4>
        <p class="text-muted">Hãy tham khảo danh mục sản phẩm và chọn các mặt hàng cần nhập về đại lý.</p>
        <div class="mt-3">
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary px-4 fw-semibold">
                <i class="bi bi-grid me-1"></i> Khám Phá Danh Mục Bán Buôn
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        <!-- Cart Items Table -->
        <div class="col-lg-8">
            <div class="card card-custom p-3 shadow-sm">
                <div class="table-responsive">
                    <table class="table align-middle table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 45%;">Mặt hàng</th>
                                <th class="text-end" style="width: 20%;">Đơn giá</th>
                                <th class="text-center" style="width: 15%;">Số lượng</th>
                                <th class="text-end" style="width: 20%;">Thành tiền</th>
                                <th class="text-center" style="width: 5%;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@item.ItemName</div>
                                        <div class="text-muted small">
                                            <span>Mã #@item.ItemID</span> &bull; 
                                            <span>Size: @item.Size</span> &bull; 
                                            <span class="text-success">Kho còn: @item.AvailableStock</span>
                                        </div>
                                    </td>
                                    <td class="text-end fw-semibold">
                                        @item.Price.ToString("#,##0") ₫
                                    </td>
                                    <td>
                                        <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="d-flex justify-content-center">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="itemId" value="@item.ItemID" />
                                            <input type="number" name="quantity" value="@item.Quantity" min="1" max="@item.AvailableStock" 
                                                   class="form-control form-control-sm text-center" style="width: 75px;" 
                                                   onchange="this.form.submit()" />
                                        </form>
                                    </td>
                                    <td class="text-end fw-bold text-primary">
                                        @item.TotalAmount.ToString("#,##0") ₫
                                    </td>
                                    <td class="text-center">
                                        <form asp-controller="Cart" asp-action="RemoveItem" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="itemId" value="@item.ItemID" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm p-1" title="Xóa khỏi giỏ">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                    <form asp-controller="Cart" asp-action="Clear" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Bạn có chắc chắn muốn xóa toàn bộ giỏ hàng?');">
                            <i class="bi bi-trash3 me-1"></i> Xóa tất cả
                        </button>
                    </form>
                    <div class="text-muted small">
                        Tổng số lượng sản phẩm: <strong>@Model.TotalQuantity</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Summary & Checkout Card -->
        <div class="col-lg-4">
            <div class="card card-custom p-4 shadow-sm sticky-top" style="top: 80px;">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                    <i class="bi bi-receipt me-2 text-primary"></i>Tổng Kết Đơn Đặt Buôn
                </h5>

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Tổng số món:</span>
                    <span class="fw-semibold">@Model.Items.Count mặt hàng</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Tổng số lượng:</span>
                    <span class="fw-semibold">@Model.TotalQuantity sản phẩm</span>
                </div>
                <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                    <span class="text-muted">Thuế VAT (0% xuất buôn):</span>
                    <span class="fw-semibold">0 ₫</span>
                </div>

                <div class="d-flex justify-content-between align-items-baseline mb-4">
                    <span class="fs-6 fw-bold">Tổng thanh toán:</span>
                    <span class="fs-4 fw-bold text-danger">@Model.TotalAmount.ToString("#,##0") ₫</span>
                </div>

                <a asp-controller="Order" asp-action="Checkout" class="btn btn-success btn-lg w-100 fw-bold shadow-sm py-2">
                    <i class="bi bi-check2-circle me-1"></i> Tiến Hành Đặt Hàng
                </a>

                <div class="alert alert-info mt-3 p-2 small mb-0">
                    <i class="bi bi-shield-check me-1"></i> Đơn hàng được đảm bảo xử lý thông qua <strong>Database Transaction</strong> tự động khấu trừ kho.
                </div>
            </div>
        </div>
    </div>
}
