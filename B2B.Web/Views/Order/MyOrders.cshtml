@model B2B.Web.Models.MyOrdersViewModel
@{
    ViewData["Title"] = "Đơn Hàng Của Tôi (My Orders)";
    var statuses = new[] { "All", "Pending", "Confirmed", "Shipped", "Delivered", "Cancelled" };
}

<!-- Hero Header -->
<div class="p-4 mb-4 rounded-3 shadow-sm text-white d-flex flex-wrap justify-content-between align-items-center"
     style="background: linear-gradient(135deg, #1a365d 0%, #2b6cb0 100%);">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-receipt-cutoff me-2 text-warning"></i>Lịch Sử Đơn Hàng Đại Lý (My Orders)
        </h2>
        <p class="mb-0 text-white-50">
            Đại lý: <strong class="text-white">@Model.AgentName</strong> (Mã ĐL #@Model.AgentID) &bull; Chỉ hiển thị các đơn hàng thuộc quyền sở hữu của tài khoản này.
        </p>
    </div>
    <div class="mt-3 mt-md-0 d-flex gap-2">
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-warning fw-bold text-dark px-3">
            <i class="bi bi-cart-plus me-1"></i> Đặt Đơn Hàng Mới
        </a>
    </div>
</div>

<!-- Summary KPI Cards -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3 mb-4">
    <div class="col">
        <div class="card card-custom p-3 h-100 border-start border-4 border-primary">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Tổng Số Đơn Hàng</div>
                    <div class="fs-3 fw-bold text-primary mt-1">@Model.TotalOrdersCount</div>
                </div>
                <div class="bg-primary-subtle text-primary rounded-circle p-3">
                    <i class="bi bi-bag-check fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card card-custom p-3 h-100 border-start border-4 border-danger">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Tổng Giá Trị Đã Đặt</div>
                    <div class="fs-5 fw-bold text-danger mt-1">@Model.TotalSpent.ToString("#,##0") ₫</div>
                </div>
                <div class="bg-danger-subtle text-danger rounded-circle p-3">
                    <i class="bi bi-cash-stack fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card card-custom p-3 h-100 border-start border-4 border-warning">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Đang Chờ Duyệt (Pending)</div>
                    <div class="fs-3 fw-bold text-warning-emphasis mt-1">@Model.PendingCount</div>
                </div>
                <div class="bg-warning-subtle text-warning-emphasis rounded-circle p-3">
                    <i class="bi bi-hourglass-split fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card card-custom p-3 h-100 border-start border-4 border-success">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Đã Xuất Kho / Giao Hàng</div>
                    <div class="fs-3 fw-bold text-success mt-1">@Model.ShippedOrDeliveredCount</div>
                </div>
                <div class="bg-success-subtle text-success rounded-circle p-3">
                    <i class="bi bi-truck fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filter & Search Bar -->
<div class="card card-custom p-3 mb-4">
    <form method="get" asp-controller="Order" asp-action="MyOrders" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" class="form-control border-start-0"
                       placeholder="Tìm theo mã đơn (#1, #6...) hoặc tên sản phẩm..."
                       value="@Model.SearchQuery" />
            </div>
        </div>

        <div class="col-md-4">
            <select name="status" class="form-select">
                @foreach (var s in statuses)
                {
                    var label = s switch
                    {
                        "All" => "-- Tất cả trạng thái đơn --",
                        "Pending" => "Pending (Chờ xử lý)",
                        "Confirmed" => "Confirmed (Đã xác nhận)",
                        "Shipped" => "Shipped (Đã xuất kho / Đang giao)",
                        "Delivered" => "Delivered (Đã giao thành công)",
                        "Cancelled" => "Cancelled (Đã hủy)",
                        _ => s
                    };
                    var isSelected = (string.IsNullOrEmpty(Model.StatusFilter) && s == "All") ||
                                     string.Equals(Model.StatusFilter, s, StringComparison.OrdinalIgnoreCase);
                    <option value="@s" selected="@isSelected">@label</option>
                }
            </select>
        </div>

        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1 fw-semibold">
                <i class="bi bi-funnel me-1"></i> Lọc Đơn Hàng
            </button>
            <a asp-controller="Order" asp-action="MyOrders" class="btn btn-outline-secondary" title="Xóa bộ lọc">
                <i class="bi bi-arrow-clockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Orders Data Table -->
<div class="card card-custom shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-table me-2 text-primary"></i>Danh Sách Đơn Hàng Bán Buôn
        </h5>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
            Hiển thị @Model.Orders.Count đơn hàng
        </span>
    </div>

    @if (!Model.Orders.Any())
    {
        <div class="card-body text-center py-5">
            <div class="text-muted fs-1 mb-2"><i class="bi bi-inbox"></i></div>
            <h5 class="text-secondary fw-bold">Chưa có đơn hàng nào phù hợp</h5>
            <p class="text-muted mb-3">Bạn có thể thay đổi bộ lọc hoặc bắt đầu tạo đơn đặt hàng bán buôn mới từ danh mục sản phẩm.</p>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary px-4">
                <i class="bi bi-grid me-1"></i> Xem Danh Mục Mặt Hàng
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Mã Đơn / Hóa Đơn</th>
                        <th>Ngày Đặt Hàng</th>
                        <th>Chi Tiết Sản Phẩm</th>
                        <th class="text-center">Tổng SL</th>
                        <th class="text-end">Tổng Tiền</th>
                        <th class="text-center">Trạng Thái</th>
                        <th class="text-center pe-3">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        var badgeClass = order.OrderStatus switch
                        {
                            "Pending" => "bg-warning text-dark",
                            "Confirmed" => "bg-info text-dark",
                            "Shipped" => "bg-primary text-white",
                            "Delivered" => "bg-success text-white",
                            "Cancelled" => "bg-danger text-white",
                            _ => "bg-secondary text-white"
                        };
                        var statusIcon = order.OrderStatus switch
                        {
                            "Pending" => "bi-clock-history",
                            "Confirmed" => "bi-check2-circle",
                            "Shipped" => "bi-truck",
                            "Delivered" => "bi-patch-check-fill",
                            "Cancelled" => "bi-x-circle",
                            _ => "bi-dot"
                        };

                        <tr>
                            <td class="ps-3">
                                <div class="fw-bold text-primary fs-6">#@order.OrderID</div>
                                <div class="text-muted small">INV-@order.OrderDate.ToString("yyyyMMdd")-@order.OrderID.ToString("D4")</div>
                            </td>
                            <td>
                                <div class="fw-semibold">@order.OrderDate.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                <div class="text-muted small">@order.OrderDate.ToLocalTime().ToString("HH:mm:ss")</div>
                            </td>
                            <td style="max-width: 320px;">
                                <div class="small fw-semibold text-dark">@order.LineCount dòng mặt hàng</div>
                                <div class="text-muted small text-truncate" title="@string.Join(", ", order.ItemNamesPreview)">
                                    @string.Join(" • ", order.ItemNamesPreview.Take(2))
                                    @if (order.ItemNamesPreview.Count > 2)
                                    {
                                        <span> (+@(order.ItemNamesPreview.Count - 2) món khác)</span>
                                    }
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border px-2 py-1">@order.TotalQuantity sp</span>
                            </td>
                            <td class="text-end fw-bold text-danger">
                                @order.TotalAmount.ToString("#,##0") ₫
                            </td>
                            <td class="text-center">
                                <span class="badge @badgeClass px-3 py-2">
                                    <i class="bi @statusIcon me-1"></i>@order.OrderStatus
                                </span>
                            </td>
                            <td class="text-center pe-3">
                                <a asp-controller="Order" asp-action="Invoice" asp-route-id="@order.OrderID"
                                   class="btn btn-outline-primary btn-sm fw-semibold">
                                    <i class="bi bi-printer me-1"></i> Xem & In Hóa Đơn
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="alert alert-light border mt-4 small text-muted d-flex align-items-center">
    <i class="bi bi-shield-lock-fill text-primary fs-5 me-2"></i>
    <div>
        <strong>Bảo mật phân quyền dữ liệu:</strong> Mọi yêu cầu xem lịch sử và in hóa đơn đều được xác thực theo <code>AgentID</code> của phiên đăng nhập. Hệ thống tự động chặn mọi hành vi truy cập trái phép vào mã đơn của đại lý khác.
    </div>
</div>
